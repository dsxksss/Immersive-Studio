{
  "name": "spatial-collab-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Spatial-style collaborative canvas prototype",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && tsx server/server.ts",
    "start": "npm run build:client && tsx server/server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsx --test server/test/*.test.ts",
    "test:server": "tsx --test server/test/*.test.ts",
    "start:dist": "tsx server/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
